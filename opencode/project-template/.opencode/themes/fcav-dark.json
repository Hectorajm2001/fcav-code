{
  "$schema": "https://opencode.ai/theme.json",
  "name": "fcav-dark",
  "defs": {
    "fcavBgDark": "#080D08",
    "fcavPanelDark": "#0E140E",
    "fcavElementDark": "#141D14",
    "fcavBorderDark": "#1C281B",
    "fcavGreen": "#22C55E",
    "fcavGreenHi": "#4ADE80",
    "fcavGreenDim": "#16A34A",
    "fcavGreenDeep": "#14532D",
    "uatBlue": "#003D5C",
    "uatBlueLight": "#38BDF8",
    "uatOrange": "#D05F27",
    "uatOrangeLight": "#FB923C",
    "uatGold": "#B45309",
    "uatGoldLight": "#FBBF24",
    "alertRed": "#EF4444",
    "alertRedDark": "#DC2626",
    "textDim": "#6B8070",
    "textNormal": "#4ADE80",
    "lightBg": "#FFFFFF",
    "lightPaper": "#F4FAF4",
    "lightInk1": "#E6F2E6",
    "lightText": "#0D2B14",
    "lightGray": "#5A7A60"
  },
  "theme": {
    "primary": { "dark": "fcavGreen", "light": "fcavGreen" },
    "secondary": { "dark": "uatBlueLight", "light": "uatBlue" },
    "accent": { "dark": "fcavGreenHi", "light": "fcavGreenDim" },
    "error": { "dark": "alertRed", "light": "alertRedDark" },
    "warning": { "dark": "uatGoldLight", "light": "uatGold" },
    "success": { "dark": "fcavGreenHi", "light": "fcavGreen" },
    "info": { "dark": "uatBlueLight", "light": "uatBlue" },
    "text": { "dark": "textNormal", "light": "lightText" },
    "textMuted": { "dark": "textDim", "light": "lightGray" },
    "background": { "dark": "fcavBgDark", "light": "lightBg" },
    "backgroundPanel": { "dark": "fcavPanelDark", "light": "lightPaper" },
    "backgroundElement": { "dark": "fcavElementDark", "light": "lightInk1" },
    "border": { "dark": "fcavBorderDark", "light": "lightInk1" },
    "borderActive": { "dark": "fcavGreen", "light": "fcavGreen" },
    "borderSubtle": { "dark": "fcavElementDark", "light": "lightPaper" },
    "diffAdded": { "dark": "fcavGreenDim", "light": "fcavGreen" },
    "diffRemoved": { "dark": "alertRed", "light": "alertRedDark" },
    "diffContext": { "dark": "textDim", "light": "lightGray" },
    "diffHunkHeader": { "dark": "uatBlueLight", "light": "uatBlue" },
    "diffHighlightAdded": { "dark": "fcavGreenHi", "light": "fcavGreenDim" },
    "diffHighlightRemoved": { "dark": "#EF4444", "light": "#EF4444" },
    "diffAddedBg": { "dark": "#102814", "light": "#E6F7E6" },
    "diffRemovedBg": { "dark": "#2A1010", "light": "#FEE2E2" },
    "diffContextBg": { "dark": "fcavPanelDark", "light": "lightPaper" },
    "diffLineNumber": { "dark": "textDim", "light": "lightGray" },
    "diffAddedLineNumberBg": { "dark": "#102814", "light": "#E6F7E6" },
    "diffRemovedLineNumberBg": { "dark": "#2A1010", "light": "#FEE2E2" },
    "markdownText": { "dark": "textNormal", "light": "lightText" },
    "markdownHeading": { "dark": "uatBlueLight", "light": "fcavGreenDeep" },
    "markdownLink": { "dark": "uatBlueLight", "light": "uatBlue" },
    "markdownLinkText": { "dark": "fcavGreenHi", "light": "fcavGreen" },
    "markdownCode": { "dark": "fcavGreenHi", "light": "fcavGreenDeep" },
    "markdownBlockQuote": { "dark": "textDim", "light": "lightGray" },
    "markdownEmph": { "dark": "uatOrangeLight", "light": "uatOrange" },
    "markdownStrong": { "dark": "uatGoldLight", "light": "fcavGreenDeep" },
    "markdownHorizontalRule": { "dark": "fcavBorderDark", "light": "lightInk1" },
    "markdownListItem": { "dark": "fcavGreen", "light": "fcavGreen" },
    "markdownListEnumeration": { "dark": "uatOrangeLight", "light": "uatOrange" },
    "markdownImage": { "dark": "uatBlueLight", "light": "uatBlue" },
    "markdownImageText": { "dark": "fcavGreenHi", "light": "fcavGreen" },
    "markdownCodeBlock": { "dark": "textNormal", "light": "lightText" },
    "syntaxComment": { "dark": "textDim", "light": "#658269" },
    "syntaxKeyword": { "dark": "uatOrangeLight", "light": "fcavGreenDeep" },
    "syntaxFunction": { "dark": "uatBlueLight", "light": "uatBlue" },
    "syntaxVariable": { "dark": "textNormal", "light": "lightText" },
    "syntaxString": { "dark": "fcavGreen", "light": "fcavGreenDim" },
    "syntaxNumber": { "dark": "uatGoldLight", "light": "uatGold" },
    "syntaxType": { "dark": "uatGoldLight", "light": "fcavGreenDeep" },
    "syntaxOperator": { "dark": "fcavGreenDim", "light": "fcavGreen" },
    "syntaxPunctuation": { "dark": "textNormal", "light": "lightText" }
  }
}
